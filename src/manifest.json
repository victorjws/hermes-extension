{
  "name": "Hermes Downloader",
  "version": "1.0",
  "manifest_version": 2,
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "storage",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "option.html",
    "open_in_tab": true
  },
  "devtools_page": "devtool.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "jinwon.seo25@gmail.com",
      "strict_min_version": "88.0"
    }
  }
}
