{
  "name": "Hermes Downloader extension",
  "version": "0.2.0",
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "hermes-extension@hermes-downloader"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "storage",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "option.html",
    "open_in_tab": true
  },
  "devtools_page": "devtool.html"
}
